struct SwingPoint
{
    datetime time;
    double   price;
    int      barIndex;
    bool     isHigh;
    int      barsAgo;
    
    void Reset()
    {
        time = 0;
        price = 0;
        barIndex = 0;
        isHigh = false;
        barsAgo = 0;
    }
};

struct FibonacciData
{
    SwingPoint swingHigh;
    SwingPoint swingLow;
    SwingPoint allSwingHighs[];
    SwingPoint allSwingLows[];
    
