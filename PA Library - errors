    status += StringFormat("  Price Position: %s\n",
                          g_symbolData[symbolIndex].priceIsAbove ? "Bullish Setup" :
                          (g_symbolData[symbolIndex].priceIsBelow ? "Bearish Setup" : "Neutral"));
    status += StringFormat("  Lot Size: %.2f\n", g_symbolData[symbolIndex].lotSize);
    status += StringFormat("  Stop Loss: %.5f\n", g_symbolData[symbolIndex].stopLoss);
    status += StringFormat("  Consecutive Losses: %d\n", g_symbolData[symbolIndex].consecLosses);
    
    if(g_symbolData[symbolIndex].tradingPaused)
        status += StringFormat("  Paused Until: %s\n", 
                              TimeToString(g_symbolData[symbolIndex].pausedUntil, TIME_DATE | TIME_MINUTES));
    
    if(UseAdvancedRisk)
        status += StringFormat("  Risk Mode: %s\n", GetAdvancedRiskStatus());
                              
    return status;
}

//+------------------------------------------------------------------+
//| Get Advanced Risk Status                                         |
//+------------------------------------------------------------------+
string GetAdvancedRiskStatus()
{
    if(!UseAdvancedRisk)
        return "Standard Risk";
        
    string status = "";
    
    if(g_advCurrentDrawdown >= DrawdownThreshold && UseDrawdownDefense)
    {
        status = StringFormat("🛡�? DEFENSE (%.1f%% DD) | Risk: %.2f%%", 
                             g_advCurrentDrawdown, g_advAdjustedRisk);
    }
    else if(g_advCurrentProfit >= ProfitThreshold && UseProfitAccelerator)
    {
        status = StringFormat("🚀 ACCELERATOR (+%.1f%%) | Risk: %.2f%%", 
                             g_advCurrentProfit, g_advAdjustedRisk);
    }
    else
    {
        status = StringFormat("�? NORMAL | Risk: %.2f%%", g_advAdjustedRisk);
    }
    
    return status;
}

//+------------------------------------------------------------------+
//| Validate Symbol Configuration                                    |
//+------------------------------------------------------------------+
bool ValidateSymbolConfig(const string symbol)
{
    if(!g_symbolInfo.Name(symbol))
    {
        Print("ERROR: Cannot select symbol ", symbol);
        return false;
    }
    
    if(!g_symbolInfo.IsSynchronized())
    {
        Print("ERROR: Symbol ", symbol, " is not synchronized");
        return false;
    }
    
    long tradeMode = g_symbolInfo.TradeMode();
    if(tradeMode == SYMBOL_TRADE_MODE_DISABLED || tradeMode == SYMBOL_TRADE_MODE_CLOSEONLY)
    {
        Print("ERROR: Trading is disabled for symbol ", symbol);
        return false;
    }
    
    double minLot = g_symbolInfo.LotsMin();
    if(minLot <= 0)
    {
        Print("ERROR: Invalid minimum lot size for symbol ", symbol);
        return false;
    }
    
    return true;
}

//+------------------------------------------------------------------+
//| Reset Symbol Data                                                |
//+------------------------------------------------------------------+
void ResetSymbolData(const string symbol)
{
    int symbolIndex = GetSymbolIndex(symbol);
    if(symbolIndex < 0)
        return;
        
    g_symbolData[symbolIndex].momentum = 0.0;
    g_symbolData[symbolIndex].stopLoss = 0.0;
    g_symbolData[symbolIndex].lotSize = 0.01;
    g_symbolData[symbolIndex].isBullishFib = false;
    g_symbolData[symbolIndex].isBearishFib = false;
    g_symbolData[symbolIndex].priceIsAbove = false;
    g_symbolData[symbolIndex].priceIsBelow = false;
    g_symbolData[symbolIndex].highestPrice = 0.0;
    g_symbolData[symbolIndex].lowestPrice = 0.0;
    g_symbolData[symbolIndex].topPrice = 0.0;
    g_symbolData[symbolIndex].bottomPrice = 0.0;
    g_symbolData[symbolIndex].fibData.Reset();
    g_symbolData[symbolIndex].rejectionSignal.Reset();
    
    ObjectDelete(0, FIB_PREFIX + symbol);
    ObjectDelete(0, HLINE_PREFIX + symbol);
    ObjectDelete(0, RECT_PREFIX + symbol);
    
    LogDebug("Symbol data reset: " + symbol);
}

//+------------------------------------------------------------------+
//| Get Active Positions Count                                       |
//+------------------------------------------------------------------+
int GetActivePositionsCount(const string symbol = "")
{
    int count = 0;
    int total = PositionsTotal();
    
    for(int i = 0; i < total; i++)
    {
        if(g_position.SelectByIndex(i))
        {
            if(symbol == "" || g_position.Symbol() == symbol)
                count++;
        }
    }
    
    return count;
}

//+------------------------------------------------------------------+
//| Close All Positions for Symbol                                   |
//+------------------------------------------------------------------+
bool CloseAllPositions(const string symbol)
{
    bool success = true;
    int total = PositionsTotal();
    
    for(int i = total - 1; i >= 0; i--)
    {
        if(g_position.SelectByIndex(i))
        {
            if(g_position.Symbol() == symbol)
            {
                if(!g_trade.PositionClose(g_position.Ticket()))
                {
                    Print("Failed to close position ", g_position.Ticket());
                    success = false;
                }
            }
        }
    }
    
    return success;
}

//+------------------------------------------------------------------+
//| Calculate Total Profit for Symbol                                |
//+------------------------------------------------------------------+
double GetTotalProfit(const string symbol = "")
{
    double totalProfit = 0.0;
    int total = PositionsTotal();
    
    for(int i = 0; i < total; i++)
    {
        if(g_position.SelectByIndex(i))
        {
            if(symbol == "" || g_position.Symbol() == symbol)
            {
                totalProfit += g_position.Profit() + g_position.Swap() + g_position.Commission();
            }
        }
    }
    
    return totalProfit;
}

